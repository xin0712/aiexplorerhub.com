# AI 助手环境变量示例
#
# 用法：复制成 .env.local（本地）或填到 Vercel 项目的 Environment Variables（线上）。
#       .env* 已在 .gitignore 中，不会被提交。
#
# 这些值只在服务端读取（api/chat.mjs），永远不会发送到浏览器。

# 必填：模型服务的 API Key
AI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：接口地址（默认 DeepSeek 官方）
AI_BASE_URL=https://api.deepseek.com/v1

# 可选：模型名（默认 deepseek-chat）
AI_MODEL=deepseek-chat
